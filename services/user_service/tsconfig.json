{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "lib": ["es2017"],
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",  // Output folder for compiled JS files
    "strict": false,  // Optional, set to true for stricter checks
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node"
  },
  "include": ["**/*.ts"],  // Include all TypeScript files in the root
  "exclude": ["node_modules", "dist"]  // Exclude dist and node_modules
}
